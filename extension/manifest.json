{
  "manifest_version": 3,
  "name": "FOCUS",
  "version": "1.0",
  "description": "DSA Smart Study Tracker",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "action": {
    "default_title": "FOCUS"
  }
}